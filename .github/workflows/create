name: Kernel ARMv7 Native Build

on:
  push:
    branches: [main]

jobs:
  build-kernel:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout kernel source
        uses: actions/checkout@v4

      - name: Enable QEMU for ARM (via binfmt)
        run: |
          docker run --rm --privileged tonistiigi/binfmt --install all

      - name: Run ARMv7 container and build kernel
        run: |
          docker run --rm --platform linux/arm/v7 \
            -v ${{ github.workspace }}:/kernel \
            -w /kernel \
            arm32v7/debian:bullseye \
            bash -c "
              apt update &&
              apt install -y build-essential bc kmod cpio flex bison \
                libncurses-dev libelf-dev libssl-dev dwarves fakeroot \
                rsync xz-utils ccache lzop liblz4-tool gcc-aarch64-linux-gnu \
                gcc-9-aarch64-linux-gnu gcc-arm-linux-gnueabihf gcc-9-arm-linux-gnueabihf
              update-alternatives --install /usr/bin/arm-linux-gnueabihf-gcc arm-linux-gnueabihf-gcc /usr/bin/arm-linux-gnueabihf-gcc-9 90
              update-alternatives --set arm-linux-gnueabihf-gcc /usr/bin/arm-linux-gnueabihf-gcc-9
              make ARCH=arm uz801v3_defconfig &&
              make -j$(nproc) ARCH=arm bindeb-pkg
            "

      - name: List kernel DEBs
        run: ls -lh ../*.deb || true
